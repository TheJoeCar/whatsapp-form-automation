#!/usr/bin/env python3
"""Entry point for the wa CLI.

This wrapper script allows argcomplete to properly register tab-completion
for the whatsapp-form-automation CLI.

Usage:
    ./wa --help
    ./wa run
    eval "$(wa completion bash)"
"""

import os
import sys
from pathlib import Path


def main() -> None:
    project_root = Path(__file__).resolve().parent
    venv_python = project_root / ".venv" / "bin" / "python"

    if not venv_python.exists():
        python = sys.executable
    else:
        python = str(venv_python)

    # Use execv to replace this process, preserving file descriptors
    # (argcomplete uses FDs 8 and 9 for communication with the shell)
    os.execv(python, [python, "-m", "src.cli"] + sys.argv[1:])


if __name__ == "__main__":
    main()
